#!/bin/sh
# NOVA Compiler & Toolchain Executable Wrapper
# Automatically selects Python 3.10+, caching the choice so repeat
# invocations skip the version probe (which otherwise costs a whole
# extra Python startup on every single `nova` call).

DIR="$(dirname "$0")"
CACHE="$DIR/.nova_cache/python-interpreter"

# An explicit PYTHON=... override always wins and is never cached, so it
# never leaks into a later invocation that didn't set it.
if [ -z "$PYTHON" ] && [ -r "$CACHE" ]; then
    CACHED="$(cat "$CACHE" 2>/dev/null)"
    if [ -n "$CACHED" ] && command -v "$CACHED" >/dev/null 2>&1; then
        PYTHON="$CACHED"
    fi
fi

if [ -z "$PYTHON" ]; then
    # Prefer explicit 3.1x interpreters first — on a machine where the
    # bare `python3` is too old (common: macOS ships 3.9), trying it
    # first would waste a full interpreter startup just to fail the
    # version check. Try the likely-correct ones before the generic one.
    for CAND in python3.13 python3.12 python3.11 python3.10 python3; do
        if command -v "$CAND" >/dev/null 2>&1 && \
           "$CAND" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
            PYTHON="$CAND"
            break
        fi
    done
    if [ -z "$PYTHON" ]; then
        echo "error: no Python 3.10+ interpreter found on PATH" >&2
        exit 1
    fi
    mkdir -p "$DIR/.nova_cache" 2>/dev/null
    printf '%s' "$PYTHON" > "$CACHE" 2>/dev/null
fi

export PYTHONPATH="$DIR:$PYTHONPATH"

exec "$PYTHON" -m compiler.nova_compiler.cli "$@"
